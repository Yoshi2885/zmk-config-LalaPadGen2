#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3
#define MAC_SC_SCALE    2
#define WIN_SC_SCALE    50

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q              &kp W          &kp E          &kp R                     &kp T                                                      &kp Y      &kp U                 &kp I            &kp O        &kp P
&kp A              &kp S          &kp D          &kp F                     &kp G                                                      &kp H      &kp J                 &kp K            &kp L        &mt2 EQUAL MINUS
&mt2 LEFT_SHIFT Z  &kp X          &kp C          &kp V                     &kp B                                                      &kp N      &kp M                 &kp COMMA        &kp PERIOD   &mt2 RIGHT_SHIFT SLASH
&mt2 LCTRL TAB     &kp LWIN       &kp LEFT_ALT   &mt2 LEFT_COMMAND ESCAPE  &lt 1 SPACE   &mt2 LEFT_SHIFT LANG2  &lt 4 LANG1           &kp ENTER  &lt 2 BACKSPACE       &kp LS(LC(TAB))  &kp LC(TAB)  &mt2 BACKSLASH UNDERSCORE
                   &kp LA(SPACE)  &kp LC(RIGHT)  &kp C_VOLUME_DOWN         &kp LC(LEFT)  &kp C_VOLUME_UP        &kp C_BRIGHTNESS_INC  &mkp MB4   &kp C_BRIGHTNESS_DEC  &mkp MB5         &none
&mkp LCLK          &mkp RCLK      &mkp MCLK                                                                                                                            &mkp LCLK        &mkp RCLK    &mkp MCLK
&mkp MB4           &mkp MB5       &kp LG(TAB)    &kp LG(D)                 &kp LCTRL                                                  &mkp MB4   &mkp MB5              &kp LG(TAB)      &kp LG(D)    &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp F1            &kp F2             &kp F3   &kp F4   &kp F5                    &kp KP_NUMLOCK    &kp KP_NUMBER_7    &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&kp F6            &kp F7             &kp F8   &kp F9   &kp F10                   &kp TAB           &kp KP_NUMBER_4    &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
&kp F11           &kp F12            &kp F13  &kp F14  &kp F15                   &kp KP_NUMBER_0   &kp KP_NUMBER_1    &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ASTERISK
&trans            &trans             &trans   &trans   &trans   &trans  &kp DEL  &kp ENTER         &kp BACKSPACE      &kp UNDERSCORE   &kp KP_DOT       &kp KP_DIVIDE
                  &trans             &trans   &trans   &trans   &trans  &trans   &trans            &trans             &trans           &trans
&trans            &trans             &trans                                                                           &trans           &trans           &trans
&kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans   &trans   &trans                    &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans           &trans           &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&kp EXCLAMATION      &kp AT_SIGN                  &kp HASH                  &kp DOLLAR                          &kp PERCENT                            &kp PAGE_UP    &kp HOME        &kp UP_ARROW     &kp END  &kp PRINTSCREEN
&mt2 LEFT_ALT CARET  &mt2 LEFT_COMMAND AMPERSAND  &mt2 LEFT_SHIFT ASTERISK  &mt2 LEFT_CONTROL LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                  &kp PAGE_DOWN  &kp LEFT        &kp RIGHT_ARROW  &trans   &trans
&kp GRAVE            &kp SQT                      &kp SEMI                  &kp LEFT_BRACKET                    &kp RIGHT_BRACKET                      &trans         &kp DOWN_ARROW  &trans           &trans   &kp RIGHT_SHIFT
&kp LEFT_BRACE       &kp RIGHT_BRACE              &trans                    &kp LESS_THAN                       &kp GREATER_THAN       &trans  &trans  &trans         &trans          &trans           &trans   &trans
                     &trans                       &trans                    &trans                              &trans                 &trans  &trans  &trans         &trans          &trans           &trans
&trans               &trans                       &trans                                                                                                                              &trans           &trans   &trans
&trans               &trans                       &trans                    &trans                              &trans                                 &trans         &trans          &trans           &trans   &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                   &out OUT_TOG                            &bt BT_SEL 0                            &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                  &sys_reset                              &bootloader                             &bt BT_CLR                     &bt BT_CLR_ALL                 &trans
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                  &zip_dyn_scale ZDS_XY ZDS_INC           &zip_dyn_scale ZDS_XY ZDS_DEC           &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans   &trans   &trans   &trans   &trans   &trans  &trans  &zip_dyn_scale_set ZDS_SC MAC_SC_SCALE  &zip_dyn_scale_set ZDS_SC WIN_SC_SCALE  &trans                         &trans                         &trans
         &trans   &trans   &trans   &trans   &trans  &trans  &trans                                  &trans                                  &trans                         &trans
&trans   &trans   &trans                                                                                                                     &trans                         &trans                         &trans
&trans   &trans   &trans   &trans   &trans                   &trans                                  &trans                                  &trans                         &trans                         &trans
            >;
        };

        SHORTCUT_LAYER {
            bindings = <
&trans                &trans  &kp LA(LC(D))  &kp LA(LC(F))      &kp LA(LC(G))                  &trans  &trans                      &trans                       &trans  &trans
&kp LS(LG(NUMBER_5))  &trans  &kp LA(LC(E))  &kp LC(LA(ENTER))  &kp LA(LC(T))                  &trans  &kp LA(LC(LG(LEFT_ARROW)))  &kp LA(LC(LG(RIGHT_ARROW)))  &trans  &trans
&trans                &trans  &trans         &trans             &trans                         &trans  &trans                      &trans                       &trans  &trans
&trans                &trans  &trans         &trans             &trans         &mo 3   &trans  &trans  &trans                      &trans                       &trans  &trans
                      &trans  &trans         &trans             &trans         &trans  &trans  &trans  &trans                      &trans                       &trans
&trans                &trans  &trans                                                                                               &trans                       &trans  &trans
&trans                &trans  &trans         &trans             &trans                         &trans  &trans                      &trans                       &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
