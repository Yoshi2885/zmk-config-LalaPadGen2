#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3
#define MAC_SC_SCALE    2
#define WIN_SC_SCALE    30

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q              &kp W          &kp E             &kp R                  &kp T                                                      &kp Y      &kp U                 &kp I                       &kp O                       &kp P
&kp A              &kp S          &kp D             &kp F                  &kp G                                                      &kp H      &kp J                 &kp K                       &kp L                       &kp SEMI
&mt2 LEFT_SHIFT Z  &kp X          &kp C             &kp V                  &kp B                                                      &kp N      &kp M                 &kp COMMA                   &kp PERIOD                  &mt2 RIGHT_SHIFT SLASH
&mt2 LCTRL ESCAPE  &kp LWIN       &kp LEFT_ALT      &mt2 LEFT_COMMAND TAB  &lt 1 SPACE   &mt2 LEFT_SHIFT LANG2  &lt 4 LANG1           &kp ENTER  &lt 2 BACKSPACE       &mt2 RIGHT_ALT LS(LC(TAB))  &mt2 RIGHT_COMMAND LC(TAB)  &mt2 RIGHT_CONTROL MINUS
                   &kp LA(SPACE)  &kp LC(RIGHT)     &kp C_VOLUME_DOWN      &kp LC(LEFT)  &kp C_VOLUME_UP        &kp C_BRIGHTNESS_INC  &mkp MB4   &kp C_BRIGHTNESS_DEC  &mkp MB5                    &kp K_MUTE
&mkp LCLK          &mkp RCLK      &mkp MCLK                                                                                                                            &mkp LCLK                   &mkp RCLK                   &mkp MCLK
&mkp MB4           &mkp MB5       &kp LC(UP_ARROW)  &kp LA(SPACE)          &mkp MB5                                                   &mkp MB4   &mkp MB5              &kp LC(UP_ARROW)            &kp LA(SPACE)               &mkp MB5
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp F1            &kp F2                &kp F3              &kp F4                &kp F5                          &kp KP_NUMLOCK    &kp KP_NUMBER_7    &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&mt2 LEFT_ALT F6  &mt2 LEFT_COMMAND F7  &mt2 LEFT_SHIFT F8  &mt2 LEFT_CONTROL F9  &kp F10                         &kp EQUAL         &kp KP_NUMBER_4    &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
&kp F11           &kp F12               &kp F13             &kp F14               &kp F15                         &kp KP_NUMBER_0   &kp KP_NUMBER_1    &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ASTERISK
&trans            &trans                &trans              &trans                &trans   &trans  &kp BACKSPACE  &kp ENTER         &kp DELETE         &kp UNDERSCORE   &kp KP_DOT       &kp KP_DIVIDE
                  &trans                &trans              &trans                &trans   &trans  &trans         &trans            &trans             &trans           &trans
&trans            &trans                &trans                                                                                                         &trans           &trans           &trans
&kp LC(LG(LEFT))  &kp LC(LG(RIGHT))     &trans              &trans                &trans                          &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &trans           &trans           &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&kp EXCLAMATION      &kp AT_SIGN                  &kp HASH                  &kp DOLLAR                          &kp PERCENT                            &kp PAGE_UP    &kp HOME        &kp UP_ARROW     &kp END  &kp PRINTSCREEN
&mt2 LEFT_ALT CARET  &mt2 LEFT_COMMAND AMPERSAND  &mt2 LEFT_SHIFT ASTERISK  &mt2 LEFT_CONTROL LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                  &kp PAGE_DOWN  &kp LEFT        &kp RIGHT_ARROW  &trans   &trans
&kp GRAVE            &kp SQT                      &kp SEMI                  &kp LEFT_BRACKET                    &kp RIGHT_BRACKET                      &trans         &kp DOWN_ARROW  &trans           &trans   &kp RIGHT_SHIFT
&kp EQUAL            &trans                       &trans                    &trans                              &trans                 &trans  &trans  &trans         &trans          &trans           &trans   &kp BACKSLASH
                     &trans                       &trans                    &trans                              &trans                 &trans  &trans  &trans         &trans          &trans           &trans
&trans               &trans                       &trans                                                                                                                              &trans           &trans   &trans
&trans               &trans                       &trans                    &trans                              &trans                                 &trans         &trans          &trans           &trans   &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5                                                   &out OUT_TOG                            &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10                                                  &sys_reset                              &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &trans
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15                                                  &zip_dyn_scale ZDS_XY ZDS_INC           &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&to 0    &trans   &trans   &trans   &trans   &trans  &zip_dyn_scale_set ZDS_SC MAC_SC_SCALE  &zip_dyn_scale_set ZDS_SC WIN_SC_SCALE  &trans                         &trans                         &trans                         &to 5
         &trans   &trans   &trans   &trans   &trans  &trans                                  &trans                                  &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                                                            &trans                         &trans                         &trans
&trans   &trans   &trans   &trans   &trans                                                   &trans                                  &trans                         &trans                         &trans                         &trans
            >;
        };

        SHORTCUT_LAYER {
            bindings = <
&kp LS(LG(NUMBER_5))  &kp LG(W)  &kp LA(LC(D))  &kp LA(LC(F))      &kp LA(LC(G))                  &trans  &trans                      &trans                       &trans  &kp LA(LC(DELETE))
&kp LG(A)             &kp LG(S)  &kp LA(LC(E))  &kp LC(LA(ENTER))  &kp LA(LC(T))                  &trans  &kp LA(LC(LG(LEFT_ARROW)))  &kp LA(LC(LG(RIGHT_ARROW)))  &trans  &trans
&kp LG(Z)             &kp LG(X)  &kp LG(C)      &kp LG(V)          &trans                         &trans  &trans                      &trans                       &trans  &kp RIGHT_SHIFT
&trans                &trans     &trans         &trans             &trans         &to 3   &trans  &trans  &trans                      &trans                       &trans  &trans
                      &trans     &trans         &trans             &trans         &trans  &trans  &trans  &trans                      &trans                       &trans
&trans                &trans     &trans                                                                                               &trans                       &trans  &trans
&trans                &trans     &trans         &trans             &trans                         &trans  &trans                      &trans                       &trans  &trans
            >;

            label = "shortcut_layer";
        };

        Canary_layer {
            bindings = <
&kp W              &kp L   &kp Y   &kp P   &kp B                        &kp Z   &kp F            &kp O                     &kp U                    &kp SINGLE_QUOTE
&kp C              &kp R   &kp S   &kp T   &kp G                        &kp M   &kp N            &kp E                     &kp I                    &kp A
&mt2 LEFT_SHIFT Q  &kp J   &kp V   &kp D   &kp K                        &kp X   &kp H            &kp SLASH                 &kp COMMA                &mt2 RIGHT_SHIFT PERIOD
&trans             &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans           &mt2 RIGHT_ALT BACKSLASH  &mt2 RIGHT_COMMAND SEMI  &mt2 RIGHT_CONTROL MINUS
                   &trans  &trans  &trans  &trans  &trans  &kp LC(TAB)  &trans  &kp LC(LS(TAB))  &trans                    &trans
&trans             &trans  &trans                                                                &trans                    &trans                   &trans
&trans             &trans  &trans  &trans  &trans                       &trans  &trans           &trans                    &trans                   &trans
            >;

            label = "canary_layer";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Cond_Syslayer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
